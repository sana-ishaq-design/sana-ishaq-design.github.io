---
import type {ProjectNote} from '../content/projects';
import Arrow from './Arrow.astro';
interface Props { project:ProjectNote; modal?:boolean }
const {project,modal=false}=Astro.props;
const Heading=modal?'h2':'h1';
const image=project.image==='subscribe-browse'?'/review-images/subscribe-browse-360.webp':`/review-images/${project.image}-800.webp`;
---
<article class="project-note">
  <Heading id={`note-title-${project.slug}`} class="note-title">{project.name}</Heading>
  <p class="note-category">Project note · {project.category}</p>
  <figure class="note-figure"><img src={image} width={project.width} height={project.height} alt={`${project.name} — original project interface.`} loading={modal?'lazy':'eager'} decoding="async" /></figure>
  <div class="note-content">
    <p class="note-intro">{project.context}</p>
    <dl class="note-role"><dt>Role</dt><dd>{project.role}</dd></dl>
    <h3>Design focus</h3><p>{project.decision}</p>
    <p>{project.contribution}</p>
    <a class="text-link" href={project.source}>Read the full case study <Arrow /></a>
  </div>
</article>
