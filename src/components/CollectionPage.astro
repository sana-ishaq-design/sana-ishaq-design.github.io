---
import '@fontsource-variable/manrope';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import manrope from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import serif from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import '../styles/editorial.css';
import '../styles/homepage.css';
import '../styles/collection.css';
import FullNavigation from '../components/FullNavigation.astro';
import Arrow from '../components/Arrow.astro';
import {collectionMetadata,featuredHtml} from '../content/collection';
import CollectionBrowser from './CollectionBrowser';
import projects from '../content/collection-projects.json';
import type {CollectionProject} from '../content/collection-types';
import {publishedProjects,collectionPath} from '../lib/collection-state.mjs';
const {page=1}=Astro.props;
const metadata=collectionMetadata(page);
const published:CollectionProject[]=publishedProjects(projects);
const shortcuts=['haiermall','subscribe-a-car','utworx','barcode-studio'].map(id=>published.find(p=>p.id===id)).filter((p):p is CollectionProject=>Boolean(p));
---
<!doctype html><html lang="en" data-preference="system"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="index, follow" /><Fragment set:html={metadata} /><link rel="preload" href={manrope} as="font" type="font/woff2" crossorigin="anonymous" /><link rel="preload" href={serif} as="font" type="font/woff2" crossorigin="anonymous" /><script is:inline>try{const p=localStorage.getItem('portfolio-review-theme');if(['light','dark','system'].includes(p))document.documentElement.dataset.preference=p}catch{}</script><noscript><style>@media(max-width:1000px){html .full-navigation{width:100%}html .full-navigation .header-menu-panel{position:static;box-shadow:none}}</style></noscript></head>
<body class="collection-page"><FullNavigation home={false} /><main id="main" class="page-frame" tabindex="-1">
<header class="collection-opening"><h1>UI/UX Case Studies<br /><em>Decisions behind the work.</em></h1><p>Explore selected UI/UX case studies across SaaS products, e-commerce platforms, mobile applications, and enterprise systems. Discover the challenges, design decisions, contributions, and outcomes behind each project.</p></header>
<nav id="filtersRow" class="collection-index" aria-label="Jump to a case study"><span>Explore by project</span>{shortcuts.map(p=><a href={`${collectionPath(Math.floor(published.findIndex(item=>item.id===p.id)/4)+1)}#${p.id}`}>{p.title}</a>)}</nav>
<CollectionBrowser projects={published} featuredHtml={featuredHtml} initialPage={page} client:load />
<section class="collection-contact" aria-labelledby="collection-contact-title"><h2 id="collection-contact-title">Seen enough to know<br /><em>this is the right fit?</em></h2><p>The first call is 30 minutes, free, and focused entirely on your product — not a sales pitch. Come with a problem. Leave with a direction.</p><a class="text-link" href="https://calendly.com/sanaishaq/sana-uiux">Book a Free Strategy Call <Arrow /></a></section>
</main><footer class="collection-footer page-frame"><p>© 2026 Sana Ishaq · All rights reserved</p><div><a class="text-link" href="https://www.linkedin.com/in/sanaishaq/">LinkedIn <Arrow /></a><a class="text-link" href="https://www.upwork.com/freelancers/~0105c1b39c32a3d461">Upwork <Arrow /></a><a class="text-link" href="mailto:sanaishaq47@gmail.com">Email <Arrow /></a></div></footer></body></html>


