---
import '@fontsource-variable/manrope';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/editorial.css';
import '../styles/homepage.css';
import copy from '../content/homepage.json';
const {title=copy.metadata.title,description=copy.metadata.description,canonical='https://sana-ishaq-design.github.io/',note=false}=Astro.props;
// The old profile-photo URL is missing; about.png is an illustration, not a portrait.
// Omit that optional property in the review candidate rather than misidentify an image.
const person=Object.fromEntries(Object.entries(copy.metadata.person).filter(([key])=>key!=='image'));
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex, follow" />
<title>{title}</title>
{!note ? copy.metadata.meta.filter(meta=>meta.name!=='viewport').map(meta=><meta {...meta} />) : <>
  <meta name="description" content={description} />
  <meta name="author" content="Sana Ishaq" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://sana-ishaq-design.github.io/assets/img/social-preview.png" />
</>}
<link rel="canonical" href={canonical} />
{!note && <script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g,'\\u003c')} />}
<noscript><style>@media(max-width:1000px){html .full-navigation{width:100%}html .full-navigation .header-menu-panel{position:static;box-shadow:none}}</style></noscript>
<script is:inline>
  try {
    const preference=localStorage.getItem('portfolio-review-theme');
    if(['light','dark','system'].includes(preference))document.documentElement.dataset.preference=preference;
  } catch {}
</script>
