---
import '@fontsource-variable/manrope';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import manropeFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import editorialFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import '../styles/editorial.css';
import '../styles/homepage.css';
import '../styles/haiermall-case.css';
import FullNavigation from './FullNavigation.astro';
import ProjectOutcomes from './ProjectOutcomes';
import Arrow from './Arrow.astro';
import HaierScreen from './HaierScreen.astro';
import CaseChapters from './CaseChapters.astro';
import EditorialProse from './EditorialProse.astro';
import {haiermallOutcomes,haiermallAttribution} from '../content/haiermall';
import {metadata,context,findings,decisions,learnings,callouts,before,after,findingLinks} from '../content/haiermall-story';
interface Props { preview?:boolean }
const {preview=false}=Astro.props;
const chapters=[['the-project','Project'],['the-impact','Impact'],['understanding-the-problem','Problem & insights'],['purchase-journey','Purchase journey'],['building-for-implementation','Implementation'],['results-and-reflection','Reflection'],['whats-next',"What's next"]] as const;
---
<!doctype html>
<html lang="en" data-preference="system">
<head>
 <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
 <link rel="preload" href={manropeFont} as="font" type="font/woff2" crossorigin="anonymous" />
 <link rel="preload" href={editorialFont} as="font" type="font/woff2" crossorigin="anonymous" />
 <meta name="robots" content={preview?'noindex, follow':'index, follow'} />
 <Fragment set:html={metadata} />
 <noscript><style>@media(max-width:1000px){html .full-navigation{width:100%}html .full-navigation .header-menu-panel{position:static;box-shadow:none}}</style></noscript>
 <script is:inline>try{const p=localStorage.getItem('portfolio-review-theme');if(['light','dark','system'].includes(p))document.documentElement.dataset.preference=p}catch{}</script>
</head>
<body class="haiermall-case">
 <FullNavigation home={false} />
 <main id="main" tabindex="-1">
  <section id="the-project" class="case-opening page-frame" aria-labelledby="case-title">
   <div class="case-identity"><p>HaierMall</p><p>E-commerce UX redesign · CRO · UX Audit</p></div>
   <h1 id="case-title">Redesigning the<br /><em>Purchase Journey</em></h1>
   <div class="case-context"><p>{context}</p><dl class="case-facts">
    <div><dt>Role</dt><dd>Lead UI/UX Designer<span>Sole designer</span></dd></div>
    <div><dt>Status</dt><dd>Phase 1<span>Delivered &amp; live</span></dd></div>
    <div><dt>Deliverables</dt><dd>Design system<span>50+ components</span></dd></div>
    <div><dt>Focus</dt><dd>CRO · Brand trust<span>Visual hierarchy</span></dd></div>
   </dl></div>
  </section>
  <figure class="case-cover">
   <img src="/review-images/haier-home-1440.webp" srcset="/review-images/haier-home-480.webp 480w, /review-images/haier-home-800.webp 800w, /review-images/haier-home-1440.webp 1440w" sizes="100vw" width="1440" height="1929" alt="HaierMall redesigned homepage with appliance categories, promotional hierarchy and product discovery." fetchpriority="high" />
   <figcaption class="page-frame">HaierMall homepage · Original desktop design</figcaption>
  </figure>
  <section id="the-impact" class="case-results" aria-labelledby="impact-title">
   <h2 id="impact-title" class="case-impact-heading page-frame">The impact</h2>
   <div id="results-grid"><ProjectOutcomes outcomes={haiermallOutcomes} attribution={{...haiermallAttribution,source:'#results-and-reflection'}} /></div>
   <p class="case-reporting page-frame">Due to internal reporting and analytics access restrictions, raw analytics dashboards were not directly accessible during this case study.</p>
  </section>
  <CaseChapters chapters={chapters} />
  <section id="understanding-the-problem" class="story-section page-frame" aria-labelledby="problem-title">
   <h2 id="problem-title">Understanding<br /><em>the problem.</em></h2>
   <div class="problem-intro">
    <p class="story-lead">A premium brand undermined by its own platform.</p>
    <div class="story-prose"><p>40 years of global brand equity — invisible on the website. Black and white UI. No brand system. Navigation with zero hierarchy. Reviews buried below fold. Checkout visually detached from the rest of the site.</p>
     <p><strong>Phase 1 constraint:</strong> No functionality changes. No new features, no checkout flow rewrites, no recommendation engines, no personalisation. Every interaction, backend flow, and data structure stayed untouched. The only lever was design — visual language, layout, hierarchy, component quality.</p>
    </div>
   </div>
   <p class="story-question">How much conversion improvement can great design deliver <em>without touching a single line of functional code?</em></p>
   <div class="audit-introduction"><h3>Five structural failures,<br />one shared root cause</h3><p>Heuristic audit against Nielsen's 10 principles, competitive analysis across five premium appliance brands, and Baymard Institute research as the quantitative foundation.</p></div>
   <ol class="audit-findings">{findings.slice(0,5).map((item,i)=><li id={`finding-${i+1}`}><h4>{item.title}</h4><div><EditorialProse text={item.body} /><a class="text-link" href={`#${findingLinks[i].id}`}>{findingLinks[i].label} <Arrow /></a></div></li>)}</ol>
   <div class="audit-root"><h3>{findings[5].title}</h3><p>{findings[5].body}</p><a class="text-link" href="/ux-audit-service-page.html">Explore the UX Audit Service <Arrow /></a></div>
  </section>
  <section id="purchase-journey" class="journey-section" aria-labelledby="journey-title">
   <div class="story-section page-frame journey-intro">
    <h2 id="journey-title">Redesigning<br /><em>the purchase journey.</em></h2>
    <p class="story-intro">From a flat product catalog to a structured journey that orients, guides, and builds confidence at every stage. A full design system applied to optimised information architecture across every surface.</p>
    <div class="hierarchy-comparison" aria-label="Written comparison of the original and redesigned hierarchy">
     <div><h3>Before — original hierarchy</h3><ol>{before.map(text=><li>{text}</li>)}</ol></div>
     <div><h3>After — decision sequence</h3><ol>{after.map(text=><li>{text}</li>)}</ol></div>
    </div>
    <p class="story-caption">A written comparison of the documented hierarchy.</p>
    <ul id="callouts" class="hierarchy-notes">{callouts.map(text=><li>{text}</li>)}</ul>
   </div>
   <article id="brand-and-orientation" class="journey-home" aria-labelledby="brand-title">
    <div class="chapter-heading page-frame"><h3 id="brand-title">A recognisable brand.<br /><em>A clearer way in.</em></h3><p>Brand-led hero, weighted mega menu navigation, persistent flash sale sub-header. The flash sale was the primary engagement hook — invisible below the fold in the original design.</p></div>
    <HaierScreen name="haier-home" height={1929} original="/assets/img/Haier%20homepage.png" caption="Homepage" description="Brand recognition, promotional hierarchy and category discovery across the full page." alt="Complete HaierMall homepage: brand-led hero, appliance navigation, promotions and category sections." />
    <div class="home-decisions page-frame">{decisions.slice(0,2).map(item=><div><h4>{item.title}</h4><EditorialProse text={item.body} /></div>)}</div>
    <p class="chapter-link page-frame">Reported homepage-to-category outcome: −20% bounce rate. <a href="#the-impact">See the published results and context.</a></p>
   </article>
   <article id="product-discovery" class="journey-listing" aria-labelledby="discovery-title">
    <div class="chapter-heading page-frame"><h3 id="discovery-title">Give the product<br /><em>room to be evaluated.</em></h3></div>
    <div class="listing-reading page-frame"><p class="story-lead">The grid follows the purchase, not the other way around.</p><div class="story-prose"><h4>{decisions[4].title}</h4><EditorialProse text={decisions[4].body} /><p>Two-column thumbnails were too small to evaluate quality for large appliances. Grid logic matched the category and evaluation needs.</p></div></div>
    <HaierScreen name="haier-listing" height={2066} original="/assets/img/haier-product%20listing%20default.png" caption="Product listing" description="Category filters, sorting and product information support appliance evaluation." alt="HaierMall desktop product listing showing appliance products, category filters, prices and sorting." />
    <p class="chapter-link page-frame">Product discovery was +40% faster in usability testing. <a href="#the-impact">See the published results and context.</a></p>
   </article>
   <article id="purchase-confidence" class="case-decision" aria-labelledby="decision-title">
    <div class="decision-opening page-frame"><h3 id="decision-title">Product pages rebuilt around<br /><em>the purchase decision sequence.</em></h3><div class="decision-argument"><EditorialProse text={decisions[2].body} /><p class="decision-constraint">Phase 1 constraint: No functionality changes. No new features, no checkout flow rewrites, no recommendation engines, no personalisation.</p><p class="research-context">Baymard research context: the 95% figure describes external research cited in the original case study, not a HaierMall outcome.</p></div></div>
    <figure class="decision-image"><img src="/review-images/haier-detail-focus-900.webp" srcset="/review-images/haier-detail-focus-480.webp 480w, /review-images/haier-detail-focus-800.webp 800w, /review-images/haier-detail-focus-900.webp 900w" sizes="(max-width:650px) 100vw, 85vw" width="900" height="570" alt="Detail from the original desktop product page: rating, price, Buy Now action and delivery assurances." loading="lazy" /><figcaption class="page-frame">Purchase controls · Detail from the original desktop export</figcaption></figure>
    <div class="product-sequence page-frame"><p class="decision-takeaway">Reviews elevated above specs.<br />Dominant CTA.<br /><em>Decision sequence restructured.</em></p><p>The documented rationale connects the information sequence to purchase confidence: key specifications above the fold, reviews before detailed specifications, then upsells.</p></div>
    <HaierScreen name="haier-detail" height={2445} original="/assets/img/haier-product%20detail.png" caption="Product detail" description="The complete page places the purchase controls in context with product information and related products." alt="Complete HaierMall desktop product page showing the appliance, purchase controls, specifications, review tab and related products." />
   </article>
   <article id="checkout-continuity" class="journey-checkout" aria-labelledby="checkout-title">
    <div class="chapter-heading page-frame"><h3 id="checkout-title">Carry trust through<br /><em>to payment.</em></h3><div class="story-prose"><h4>{decisions[3].title}</h4><EditorialProse text={decisions[3].body} /></div></div>
    <HaierScreen name="haier-checkout" height={1496} original="/assets/img/haier-checkout.png" caption="Checkout" description="Contact and shipping fields, payment choices and the order summary share one visual system." alt="Original HaierMall desktop checkout export showing contact and shipping fields, payment choices and order summary." />
    <div class="checkout-research page-frame"><p class="story-lead">The flow stayed the same.<br /><em>The visual trust break did not.</em></p><p class="research-context">Baymard research context: the original case study cites 17% of checkout abandonment due to visual mistrust. This informed the enclosed fields, trust signals and brand continuity; it is not a measured HaierMall checkout improvement.</p></div>
   </article>
  </section>
  <section id="building-for-implementation" class="story-section handoff-section page-frame" aria-labelledby="handoff-title">
   <h2 id="handoff-title">Building for<br /><em>implementation.</em></h2>
   <div class="handoff-reading"><p class="system-statement">50+<span>components in Figma</span></p><div class="story-prose"><h3>{decisions[5].title}</h3><EditorialProse text={decisions[5].body} /><p>Designed for implementation fidelity and reduced revision cycles. Figma file available on request.</p></div></div>
  </section>
  <section id="results-and-reflection" class="story-section reflection-section page-frame" aria-labelledby="reflection-title">
   <h2 id="reflection-title">Results<br /><em>and reflection.</em></h2>
   <div class="reflection-intro"><p class="story-lead">Ease, clarity,<br /><em>and trustworthiness.</em></p><div class="story-prose"><p>Customer feedback cited these as the three primary improvements — mapping precisely to Baymard's three core drivers of e-commerce conversion confidence.</p><p>No new features. No checkout flow modifications. No personalisation. The published case study attributes the results to visual design quality, layout architecture, brand system application and component hierarchy alone.</p><p>{haiermallAttribution.text} Due to internal reporting and analytics access restrictions, raw analytics dashboards were not directly accessible during this case study.</p><a class="text-link" href="#the-impact">Return to the four verified outcomes <Arrow /></a></div></div>
   <div class="learning-list">{learnings.map((item,i)=><div><h3>{item.title}</h3><div>{i===0&&<p class="research-context">Baymard research context, not an additional project metric.</p>}<EditorialProse text={item.body} /></div></div>)}</div>
  </section>
  <section id="whats-next" class="story-section next-section page-frame" aria-labelledby="next-title">
   <h2 id="next-title">What's <em>next.</em></h2>
   <a class="next-project" href="/case-studies/subscribe-me-case-study.html"><span>Next Case Study · Subscribe Me</span><span>Contributing to a Car Subscription Platform That Reached 100K+ Downloads <Arrow /></span></a>
   <a class="text-link all-case-studies" href="/case-studies.html">All Case Studies <Arrow /></a>
   <div class="case-contact"><h3>Seen enough to know<br /><em>this is the right fit?</em></h3><p>The first call is 30 minutes, free, and focused entirely on your product — not a sales pitch. Come with a problem. Leave with a direction.</p><a class="text-link" href="https://calendly.com/sanaishaq/sana-uiux">Book a Free Strategy Call <Arrow /></a></div>
  </section>
 </main>
 <footer class="case-credits page-frame"><p>HaierMall · E-Commerce Redesign</p><p>Designed by Sana Ishaq · Lead UI/UX Designer · Developed by <a href="https://github.com/zfhassaan">Hassaan Ali</a>.</p><p>Figma file available on request.</p><a class="text-link" href="/homepage.html#selected-work">Back to selected work <Arrow /></a></footer>
</body></html>


