---
import '@fontsource-variable/manrope';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import ThemePreference from '../components/ThemePreference';
import '../styles/editorial.css';
---
<!doctype html>
<html lang="en" data-preference="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Homepage design study — Sana Ishaq</title>
    <meta name="description" content="Phase 1 review: Hero and HaierMall project chapter in First Light and Juniper Dusk." />
    <noscript><style>@media(max-width:650px){html .header-menu{width:100%}html .header-menu-panel{position:static;box-shadow:none}}</style></noscript>
    <script is:inline>
      try {
        const preference = localStorage.getItem('portfolio-review-theme');
        if (['light','dark','system'].includes(preference)) document.documentElement.dataset.preference = preference;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header page-frame">
      <a class="wordmark" href="/" aria-label="Sana Ishaq — existing portfolio">Sana Ishaq<span>Product Designer</span></a>
      <details class="header-menu" id="header-menu" open>
        <summary>Menu <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg></summary>
        <div class="header-menu-panel">
          <nav aria-label="Primary">
            <a href="#selected-work">Work</a>
            <a href="mailto:sanaishaq47@gmail.com">Get in touch <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></a>
          </nav>
          <ThemePreference client:load />
        </div>
      </details>
    </header>
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('#header-menu');
      const smallScreen = window.matchMedia('(max-width: 650px)');
      function syncMenu() { if (menu) menu.open = !smallScreen.matches; }
      syncMenu();
      smallScreen.addEventListener('change', syncMenu);
      menu?.addEventListener('keydown', event => {
        if (event.key === 'Escape' && smallScreen.matches && menu.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
      menu?.querySelector('a[href^="#"]')?.addEventListener('click', () => {
        if (smallScreen.matches) menu.open = false;
      });
    </script>

    <main id="main">
      <section class="hero page-frame" aria-labelledby="hero-title">
        <h1 id="hero-title"><span class="hero-audience">Helping SaaS Products &amp; Ecommerce Brands</span> <span class="hero-promise">Build <em><span>Better Digital</span> <span>Experiences</span></em></span></h1>
        <div class="hero-bottom">
          <p>Partnering with founders and growing teams to transform complex products into intuitive experiences that drive measurable business growth.</p>
          <div class="hero-actions">
            <a class="text-link primary-link" href="#selected-work">View Case Studies <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6" /></svg></a>
            <a class="text-link" href="https://calendly.com/sanaishaq/sana-uiux">Book a Discovery Call <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></a>
          </div>
        </div>
      </section>

      <section id="selected-work" class="selected-work" aria-labelledby="work-title">
        <div class="work-intro page-frame">
          <h2 id="work-title">Selected <em>work.</em></h2>
          <a class="text-link" href="/case-studies.html">All Case Studies <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></a>
        </div>
        <article class="project-chapter" aria-labelledby="haier-title">
          <div class="project-heading page-frame">
            <div class="project-identity"><span>HaierMall</span><span>E-commerce · Web</span></div>
            <h3 id="haier-title">Redesigning the<br class="desktop-break" /> <em>Purchase Journey</em></h3>
          </div>
          <figure class="project-figure">
            <div class="project-artwork">
              <div class="artwork-home">
                <picture>
                  <source media="(max-width: 650px)" srcset="/review-images/haier-home-focus-480.webp 480w, /review-images/haier-home-focus-800.webp 800w, /review-images/haier-home-focus-1200.webp 1200w" sizes="100vw" width="1200" height="1000" />
                  <img src="/review-images/haier-home-1280.webp" srcset="/review-images/haier-home-480.webp 480w, /review-images/haier-home-800.webp 800w, /review-images/haier-home-1280.webp 1280w" sizes="62vw" width="1440" height="1929" alt="HaierMall homepage design showing product categories, appliance promotions and product discovery." loading="lazy" decoding="async" />
                </picture>
              </div>
              <div class="artwork-detail">
                <picture>
                  <source media="(max-width: 650px)" srcset="/review-images/haier-detail-focus-480.webp 480w, /review-images/haier-detail-focus-800.webp 800w, /review-images/haier-detail-focus-900.webp 900w" sizes="calc(100vw - 40px)" width="900" height="570" />
                  <img src="/review-images/haier-detail-800.webp" srcset="/review-images/haier-detail-480.webp 480w, /review-images/haier-detail-800.webp 800w, /review-images/haier-detail-1280.webp 1280w" sizes="37vw" width="1440" height="2445" alt="HaierMall product detail design, with appliance imagery, purchase controls and product information." loading="lazy" decoding="async" />
                </picture>
              </div>
            </div>
            <figcaption class="page-frame"><span>HaierMall · Homepage &amp; product detail</span><span>Detail crops from original screens</span></figcaption>
          </figure>
          <section id="project-evidence" class="project-evidence page-frame" aria-labelledby="evidence-title">
            <div class="evidence-heading">
              <h4 id="evidence-title">Evidence from the work.</h4>
              <p class="evidence-status">Outcome figures await confirmation.</p>
            </div>
            <dl class="evidence-list">
              <div><dt>Homepage</dt><dd>Product discovery</dd></div>
              <div><dt>Product detail</dt><dd>Product evaluation</dd></div>
              <div><dt>Checkout</dt><dd>Purchase interface</dd></div>
            </dl>
            <p class="evidence-note">Project artifacts shown in the existing case study. These are design deliverables, not measured outcomes.</p>
          </section>
          <div class="project-summary page-frame">
            <div class="project-context">
              <p class="proposal-label">Proposed introduction · for approval</p>
              <p class="project-introduction">HaierMall is an appliance e-commerce platform. The redesign focuses on product discovery and purchase confidence, with homepage, product-detail and checkout interfaces.</p>
            </div>
            <div class="project-actions"><a class="text-link case-study-link" href="/case-studies/haiermall-case-study.html">Read Case Study <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></a></div>
          </div>
        </article>
      </section>
    </main>
    <footer class="review-footer page-frame"><span>Phase 1 · Homepage design study</span><a href="/">Existing portfolio <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></a></footer>
  </body>
</html>
