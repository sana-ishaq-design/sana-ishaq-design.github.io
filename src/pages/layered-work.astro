---
import manropeFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import serifItalic from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import serifRegular from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import SiteHead from '../components/SiteHead.astro';
import FullNavigation from '../components/FullNavigation.astro';
import HaierBento from '../experiments/haier-bento/Feature.astro';

import ProjectBentos from '../experiments/layered-work/ProjectBentos.astro';
import '../experiments/layered-work/journey.css';
import HomepageSections from '../components/HomepageSections.astro';
import Archive from '../components/Archive.astro';
import Footer from '../components/CompactFooter.astro';
import '../styles/homepage-refinement.css';
import Arrow from '../components/Arrow.astro';
import HeroAtmosphere from '../experiments/living-atmosphere/Atmosphere.astro';
import '../experiments/living-atmosphere/centered-content.css';
---
<!doctype html><html lang="en" data-preference="system"><head><link rel="preload" href={manropeFont} as="font" type="font/woff2" crossorigin /><link rel="preload" href={serifItalic} as="font" type="font/woff2" crossorigin /><link rel="preload" href={serifRegular} as="font" type="font/woff2" crossorigin /><SiteHead title="Layered Selected Work — isolated prototype" /></head>
<body class="complete-homepage living-prototype hero-centered layered-journey"><FullNavigation /><main id="main" tabindex="-1">
<section class="hero page-frame" aria-labelledby="hero-title">
        <HeroAtmosphere />
        <div class="hero-heading">
          <p class="hero-role">Product Designer</p>
          <h1 id="hero-title"><span class="hero-audience">Helping SaaS Products &amp; Ecommerce Brands</span> <span class="hero-promise">Build <em><span>Better Digital</span> <span>Experiences</span></em></span></h1>
        </div>
        <div class="hero-bottom">
          <p>Partnering with founders and growing teams to transform complex products into intuitive experiences that drive measurable business growth.</p>
          <div class="hero-actions">
            <a class="text-link primary-link" href="#selected-work">Explore Selected Work <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6" /></svg></a>
            <a class="text-link" href="#contact">Get in Touch <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></a>
          </div>
        </div>
      </section>
<section id="selected-work" class="selected-work" aria-labelledby="work-title" tabindex="-1">
<div class="work-intro page-frame"><h2 id="work-title">Selected work</h2><a class="text-link" href="/case-studies.html">All Case Studies <Arrow /></a></div>
<div class="ridge-stack"><div class="ridge-panel" style="--ridge-index:0"><HaierBento /></div><ProjectBentos /></div>
</section>
<HomepageSections><Archive /></HomepageSections>
</main><Footer /></body></html>

<script>
  import { setupJourney } from "../experiments/layered-work/journey";
  setupJourney();
  const header=document.querySelector<HTMLElement>('.complete-homepage .full-header');
  if(header){
    const measure=()=>document.documentElement.style.setProperty('--homepage-header-height',header.getBoundingClientRect().height+'px');
    const scrolled=()=>header.classList.toggle('is-scrolled',window.scrollY>8);
    new ResizeObserver(measure).observe(header);measure();scrolled();
    window.addEventListener('scroll',scrolled,{passive:true});
  }
</script>
