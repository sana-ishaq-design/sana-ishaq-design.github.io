---
import CollectionPage from '../../../components/CollectionPage.astro';
import projects from '../../../content/collection-projects.json';
import {publishedProjects,PAGE_SIZE} from '../../../lib/collection-state.mjs';
export function getStaticPaths(){return Array.from({length:Math.max(0,Math.ceil(publishedProjects(projects).length/PAGE_SIZE)-1)},(_,i)=>({params:{page:String(i+2)},props:{page:i+2}}))}
const {page}=Astro.props;
---
<CollectionPage page={page} />
