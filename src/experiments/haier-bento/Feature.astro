---
import Arrow from '../../components/Arrow.astro';
import {haiermallOutcomes} from '../../content/haiermall';
const destination='/case-studies/haiermall-case-study.html';
---
<article class="haier-bento page-frame" aria-labelledby="haier-bento-title">
 <div class="hb-composition">
  <header class="hb-heading">
   <div class="hb-identity"><span>01 / HAIERMALL</span><span>E-commerce · Web</span></div>
   <h3 id="haier-bento-title">Redesigning the <em>Purchase Journey</em></h3>
  </header>
  <figure class="hb-showcase">
   <a href={destination} class="hb-image-link" aria-label="Explore the HaierMall case study">
    <img src="/review-images/haier-home-1280.webp" srcset="/review-images/haier-home-480.webp 480w, /review-images/haier-home-800.webp 800w, /review-images/haier-home-1280.webp 1280w, /review-images/haier-home-1440.webp 1440w" sizes="(max-width: 800px) calc(100vw - 88px), 45vw" width="1440" height="1929" alt="HaierMall homepage with appliance discovery, product listings and a kitchen showcase." loading="lazy" decoding="async" />
   </a>
   <figcaption class="visually-hidden">Authentic HaierMall homepage design, cropped within the showcase. Open the case study for the complete project.</figcaption>
  </figure>
  <p class="hb-description">Redesigning HaierMall's e-commerce experience to simplify product discovery, reduce shopping friction, and improve conversion.</p>
  <dl class="hb-impact" aria-label="Project impact">
   {haiermallOutcomes.map(outcome=><div class="hb-metric" data-outcome={outcome.id}>
    <dt>{outcome.label}</dt><dd class="hb-value">{outcome.value}</dd>
    <dd class="hb-definition">{outcome.id==='bounce-rate'?'Homepage to category':outcome.context}</dd>
   </div>)}
  </dl>
  <div class="hb-action"><a class="text-link" href={destination}>Read Full Case Study <Arrow /></a></div>
 </div>
</article>
<style>
 .haier-bento{padding-top:48px;padding-bottom:104px}
 .hb-composition{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);column-gap:clamp(28px,3.4vw,56px);align-items:start}
 .hb-heading,.hb-description,.hb-impact,.hb-action{grid-column:2}
 .hb-heading{grid-row:1}
 .hb-identity{display:flex;justify-content:space-between;gap:20px;font-size:12px;line-height:1.6;color:var(--muted)}
 .hb-identity span:first-child{color:var(--ink);font-weight:650;letter-spacing:.025em}
 .hb-heading h3{font-size:clamp(34px,3.5vw,52px);font-weight:450;line-height:1.08;letter-spacing:-.045em;margin-top:22px;max-width:15ch}
 .hb-heading h3 em{display:block;color:var(--link);font-size:1.13em;letter-spacing:-.025em}
 .hb-showcase{grid-column:1;grid-row:1/5;align-self:stretch;min-height:580px;border-radius:18px;background:var(--image-ground);padding:24px 24px 0;overflow:hidden;position:relative}
 .hb-image-link{display:block;height:100%;border-radius:9px 9px 0 0;overflow:hidden;position:relative}
 .hb-image-link img{display:block;width:100%;height:auto;max-width:none;position:absolute;top:0;left:0;transition:transform 550ms cubic-bezier(.2,.65,.3,1);transform-origin:50% 20%}
 .hb-image-link:focus-visible{outline-offset:-5px;outline-width:3px}
 .hb-description{grid-row:2;margin-top:22px;font-size:17px;line-height:1.65;max-width:57ch;color:var(--muted)}
 .hb-impact{grid-row:3;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:28px}
 .hb-metric{display:flex;flex-direction:column;justify-content:center;min-height:138px;padding:18px 20px;border-radius:14px;background:color-mix(in srgb,var(--image-ground) 70%,var(--canvas))}
 .hb-metric:nth-child(2),.hb-metric:nth-child(3){background:color-mix(in srgb,var(--image-ground) 42%,var(--canvas))}
 .hb-value{order:-1;font-family:'Instrument Serif',Georgia,serif;font-size:52px;line-height:1;color:var(--link);letter-spacing:-.025em;margin-bottom:10px;font-variant-numeric:lining-nums}
 .hb-metric dt{font-size:15px;line-height:1.4;font-weight:550}
 .hb-definition{font-size:12px;line-height:1.5;color:var(--muted);margin-top:4px}
 .hb-action{grid-row:4;margin-top:26px}
 .hb-action a{min-height:44px;font-size:15px}
 @media(hover:hover) and (prefers-reduced-motion:no-preference){.hb-image-link:hover img{transform:translateY(-5px)}.hb-image-link:focus-visible img{transform:translateY(-5px)}}
 @media(max-width:1100px) and (min-width:801px){.hb-showcase{padding:18px 18px 0}.hb-description{font-size:16px}.hb-identity{flex-wrap:wrap;gap:4px 16px}.hb-metric{padding:16px;min-height:142px}.hb-value{font-size:46px}}
 @media(max-width:800px){
  .haier-bento{padding-top:32px;padding-bottom:72px}
  .hb-composition{display:flex;flex-direction:column;gap:0}
  .hb-heading,.hb-showcase,.hb-impact,.hb-action{width:100%}
  .hb-heading h3{font-size:clamp(34px,6.5vw,48px);max-width:20ch;margin-top:20px}
  .hb-showcase{height:auto;min-height:0;aspect-ratio:1.05;margin-top:28px;padding:20px 20px 0}
  .hb-image-link{height:100%}
  .hb-description{margin-top:24px;font-size:16px;max-width:57ch}
  .hb-impact{margin-top:24px;gap:10px}
  .hb-metric{padding:16px;min-height:145px}
  .hb-value{font-size:46px}
  .hb-metric dt{font-size:14px}
  .hb-definition{font-size:12px}
  .hb-action{margin-top:22px}
 }
 @media(max-width:360px){.hb-identity{font-size:11px;gap:10px}.hb-metric{padding:14px 12px}.hb-value{font-size:42px}}
 @media(prefers-reduced-motion:reduce){.hb-image-link img{transition:none;transform:none}}
 @media print{.hb-image-link img{position:static}.hb-showcase{overflow:visible;min-height:0}.hb-composition{break-inside:avoid}}
</style>